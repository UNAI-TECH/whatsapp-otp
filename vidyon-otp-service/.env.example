# Runtime
ENVIRONMENT=development           # development | production
LOG_LEVEL=INFO

# Provider selection
PROVIDER=mock                     # mock | whatsapp_cloud
MOCK_MODE=success                 # success | reject | timeout | unavailable

# Supabase Auth hook secret (Project A — generate in Supabase dashboard)
SEND_SMS_HOOK_SECRET=v1,whsec_PLACEHOLDER

# Request limits
PROVIDER_TIMEOUT_SECONDS=4.0
ALLOWED_COUNTRY_PREFIX=+91
PER_PHONE_LIMIT_ENABLED=true

# WhatsApp Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=PLACEHOLDER
WHATSAPP_PHONE_NUMBER_ID=PLACEHOLDER
WHATSAPP_GRAPH_API_VERSION=v19.0
WHATSAPP_TEMPLATE_NAME_EN=otp_en
WHATSAPP_TEMPLATE_NAME_TA=otp_ta
WHATSAPP_TEMPLATE_LANGUAGE_EN=en
WHATSAPP_TEMPLATE_LANGUAGE_TA=ta

# OTP Platform (Project C Edge Functions)
OTP_PLATFORM_URL=https://<project-c-ref>.supabase.co/functions/v1
OTP_PLATFORM_API_KEY=otp_PLACEHOLDER
